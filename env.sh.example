# Source this before building the daemon if your Rust toolchain does not live in
# the default location. Copy to env.sh (git-ignored) and edit.
#
# Never put an API key in here. Point `deepseek_key_file` in
# ~/.agent-monitor/config.toml at a file that holds the key and nothing else.
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export PATH="$CARGO_HOME/bin:$PATH"
